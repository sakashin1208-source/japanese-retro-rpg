@echo off
chcp 65001 > nul
cls
echo ======================================================================
echo   妖幻奇譚 〜もののけ草子〜 スマホ実機テスト用ローカルサーバー
echo ======================================================================
echo.
echo [1] PCのIPアドレスを確認しています...

for /f "tokens=4" %%a in ('route print ^| findstr 0.0.0.0.*0.0.0.0') do (
    set LOCAL_IP=%%a
)

echo.
echo ======================================================================
echo   スマホのブラウザ（Safari / Chrome）で以下のURLを開いてください:
echo.
echo   http://%LOCAL_IP%:8080
echo.
echo   ※PCとスマホが同じWi-Fiネットワークに接続されている必要があります。
echo   ※終了するには このウィンドウで [Ctrl + C] を押してください。
echo ======================================================================
echo.
echo サーバーを起動中 (ポート 8080)...
python -m http.server 8080
pause
